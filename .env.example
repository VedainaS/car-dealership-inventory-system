# Application
APP_NAME=Car Dealership Inventory API

# Development database (SQLite file on disk)
DATABASE_URL=sqlite:///./dealership.db

# Test database (used by pytest; keep separate from development data)
TEST_DATABASE_URL=sqlite:///./test_dealership.db

# JWT (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
